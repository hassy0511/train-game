{
  "name": "train-game",
  "version": "0.0.1",
  "description": "Kids 3D train game (Three.js + Rapier)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-models.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && playwright test -c tests/smoke/playwright.config.ts",
    "smoke:only": "playwright test -c tests/smoke/playwright.config.ts",
    "check:models": "node scripts/check-models.mjs",
    "budget": "node scripts/probe-budget.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassy0511/train-game.git"
  },
  "bugs": {
    "url": "https://github.com/hassy0511/train-game/issues"
  },
  "homepage": "https://github.com/hassy0511/train-game#readme",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "type": "module"
}
